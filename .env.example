# =============================================================================
# Smyrna Ready Mix Dispatch System - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# Or set these as system environment variables on your server
#
# IMPORTANT: For production deployments, set DATABASE_PATH to a location
# OUTSIDE the deployment directory to preserve data across updates.
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (CRITICAL FOR DATA PERSISTENCE)
# =============================================================================
# Path to SQLite database file
# Default: database/srm_dispatch.db (relative to app directory)
#
# FOR PRODUCTION: Set to an absolute path outside the deployment directory
# Examples:
#   Linux/Mac: /var/data/srm_dispatch.db
#   Windows: C:\ProgramData\SRMDispatch\srm_dispatch.db
#   Render.com: /var/data/srm_dispatch.db (with persistent disk)
#
DATABASE_PATH=/var/data/srm_dispatch.db

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Flask secret key - CHANGE THIS IN PRODUCTION!
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here-change-in-production

# Debug mode (set to False in production)
DEBUG=False

# =============================================================================
# GROQ AI INTEGRATION (Optional)
# =============================================================================
# API key for Groq AI assistant features
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# =============================================================================
# SAMSARA GPS INTEGRATION (Optional)
# =============================================================================
# Enable Samsara GPS tracking integration
SAMSARA_ENABLED=False

# Samsara API token (required if SAMSARA_ENABLED=True)
SAMSARA_API_TOKEN=your-samsara-api-token-here

# GPS sync interval in seconds (default: 300 = 5 minutes)
SAMSARA_SYNC_INTERVAL=300

# Geofence radius in meters for location detection
SAMSARA_GEOFENCE_RADIUS=100

# =============================================================================
# DEMO/SIMULATION MODE
# =============================================================================
# When True, simulates GPS tracking without actual Samsara API
# Set to False when using real Samsara integration
DEMO_MODE=True
